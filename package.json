{
  "name": "opends-site",
  "private": true,
  "type": "module",
  "scripts": {
    "docs:sync": "node scripts/sync-notes.mjs",
    "docs:clean": "node scripts/sync-notes.mjs --clean",
    "docs:dev": "npm run docs:sync && vitepress dev docs",
