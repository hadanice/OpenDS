    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "markdown-it-mathjax3": "^4.3.2",
    "mermaid": "^11.16.0",
    "vitepress": "2.0.0-alpha.18",
    "vue": "^3.5.39"
  }
}
